# Public browser configuration. Obtain these values from the Supabase project API settings.
# Never add service-role keys or database passwords to this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Drive sync (Supabase Edge Function secrets; never expose in VITE_* vars)
# OAuth client type: Web application, with Drive API enabled in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: root Drive folder ID. If empty, configure it in crm_drive_connections.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Supabase Edge Function runtime (set as hosted secrets, not in the browser)
SUPABASE_SERVICE_ROLE_KEY=
