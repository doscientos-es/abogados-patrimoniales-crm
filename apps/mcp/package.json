    "zod": "3.25.76"
  },
  "devDependencies": {
    "@doscientos/configs": "0.1.9",
    "@types/node": "22.20.1",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
